PUBLIC_URL=http://localhost:3000

GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

KAKAO_REST_API_KEY=replace-with-kakao-rest-api-key
KAKAO_CLIENT_SECRET=replace-with-kakao-client-secret

OPEN_BANKING_CLIENT_ID=replace-with-kftc-client-id
OPEN_BANKING_CLIENT_SECRET=replace-with-kftc-client-secret
# Account linking is off by default. Set true only after the KFTC flow is approved.
OPEN_BANKING_ENABLED=false
OPEN_BANKING_REDIRECT_URI=http://localhost:3000/api/openbanking/callback
OPEN_BANKING_USE_ORG_CODE=REPLACE10X

# Defaults below use the KFTC testbed. Replace all three only after
# operational approval and with the production URLs supplied by KFTC.
OPEN_BANKING_AUTHORIZE_URL=https://testapi.openbanking.or.kr/oauth/2.0/authorize
OPEN_BANKING_TOKEN_URL=https://testapi.openbanking.or.kr/oauth/2.0/token
OPEN_BANKING_API_BASE_URL=https://testapi.openbanking.or.kr/v2.0

# Base64-encoded random 32-byte key. Never reuse this placeholder.
TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-random-32-byte-key
